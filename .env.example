# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/lotus_assets?schema=public"

# Authentication
JWT_SECRET="change-this-to-a-long-random-secret-key-in-production"

# Server
PORT=16345
NODE_ENV=development
# Set to true only when serving over HTTPS
COOKIE_SECURE=false

# Backup
BACKUP_DIR="./backups"
BACKUP_CRON="0 2 * * *"

# Uploads (absolute path recommended on VPS, e.g. /var/www/lotus-asset-management/public/uploads)
UPLOAD_DIR="./public/uploads"
