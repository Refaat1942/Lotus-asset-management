# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/lotus_assets?schema=public"

# Authentication
JWT_SECRET="change-this-to-a-long-random-secret-key-in-production"

# Server
PORT=16435
NODE_ENV=development

# Backup
BACKUP_DIR="./backups"
BACKUP_CRON="0 2 * * *"

# Uploads
UPLOAD_DIR="./public/uploads"
